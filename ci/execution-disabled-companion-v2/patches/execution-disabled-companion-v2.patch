diff --git a/codex-rs/core/src/companion_execution_policy.rs b/codex-rs/core/src/companion_execution_policy.rs
new file mode 100644
index 0000000000..3666ad51bd
--- /dev/null
+++ b/codex-rs/core/src/companion_execution_policy.rs
@@ -0,0 +1,270 @@
+//! Frozen execution policy for the execution-disabled companion build.
+//!
+//! Scope is deliberately narrow: this module authorizes only registered,
+//! client-executed runtimes dispatched by `ToolRegistry`. Hosted/provider tools
+//! have a separate default-off path in `spec_plan` and are not claimed here.
+
+use std::collections::HashSet;
+use std::fs;
+use std::path::Path;
+use std::sync::OnceLock;
+
+use anyhow::Context;
+use codex_tools::ToolName;
+use serde::Deserialize;
+
+pub const POLICY_PATH: &str = "/etc/tidal-codex-poc/companion-exec-policy.toml";
+pub(crate) const POLICY_DENIAL_CODE: &str = "execution_disabled_by_runtime_policy";
+const POLICY_VERSION: u32 = 1;
+
+static POLICY: OnceLock<ExecutionPolicy> = OnceLock::new();
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum RuntimeOrigin {
+    Local,
+    Mcp {
+        server: String,
+        raw_tool: String,
+        connector: Option<String>,
+    },
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct PolicyFile {
+    version: u32,
+    default_action: DefaultAction,
+    hosted_tools: HostedTools,
+    #[serde(default)]
+    allowed_local_tools: Vec<String>,
+    #[serde(default)]
+    allowed_mcp_tools: Vec<McpRule>,
+}
+
+#[derive(Debug, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+enum DefaultAction {
+    Deny,
+}
+
+#[derive(Debug, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+enum HostedTools {
+    Disabled,
+}
+
+#[derive(Debug, Clone, Deserialize, PartialEq, Eq, Hash)]
+#[serde(deny_unknown_fields)]
+struct McpRule {
+    server: String,
+    raw_tool: String,
+    /// Omitted means the tool must have no connector identity.
+    connector: Option<String>,
+}
+
+#[derive(Debug)]
+pub(crate) struct ExecutionPolicy {
+    allowed_local_tools: HashSet<String>,
+    allowed_mcp_tools: HashSet<McpRule>,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum PolicyDenialReason {
+    NotInitialized,
+    HardDeny,
+    NotAllowed,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct PolicyDenial {
+    pub(crate) canonical_tool: String,
+    pub(crate) reason: PolicyDenialReason,
+}
+
+pub fn initialize() -> anyhow::Result<()> {
+    let policy = load_policy(Path::new(POLICY_PATH), RequiredOwner::Root)?;
+    POLICY
+        .set(policy)
+        .map_err(|_| anyhow::anyhow!("companion execution policy initialized more than once"))
+}
+
+pub(crate) fn authorize_registered_runtime(
+    tool_name: &ToolName,
+    origin: &RuntimeOrigin,
+) -> Result<(), PolicyDenial> {
+    let policy = POLICY.get().ok_or_else(|| PolicyDenial {
+        canonical_tool: canonical_name(tool_name),
+        reason: PolicyDenialReason::NotInitialized,
+    })?;
+    policy.authorize(tool_name, origin)
+}
+
+#[cfg(test)]
+pub(crate) fn authorize_with_policy_for_test(
+    policy: &ExecutionPolicy,
+    tool_name: &ToolName,
+    origin: &RuntimeOrigin,
+) -> Result<(), PolicyDenial> {
+    policy.authorize(tool_name, origin)
+}
+
+impl ExecutionPolicy {
+    fn authorize(&self, tool_name: &ToolName, origin: &RuntimeOrigin) -> Result<(), PolicyDenial> {
+        let canonical = canonical_name(tool_name);
+        if is_unconditionally_denied(&canonical) {
+            return Err(PolicyDenial {
+                canonical_tool: canonical,
+                reason: PolicyDenialReason::HardDeny,
+            });
+        }
+
+        let allowed = match origin {
+            RuntimeOrigin::Local => self.allowed_local_tools.contains(&canonical),
+            RuntimeOrigin::Mcp {
+                server,
+                raw_tool,
+                connector,
+            } => self.allowed_mcp_tools.contains(&McpRule {
+                server: server.clone(),
+                raw_tool: raw_tool.clone(),
+                connector: connector.clone(),
+            }),
+        };
+        allowed
+            .then_some(())
+            .ok_or(PolicyDenial {
+                canonical_tool: canonical,
+                reason: PolicyDenialReason::NotAllowed,
+            })
+    }
+}
+
+fn canonical_name(name: &ToolName) -> String {
+    name.to_string()
+}
+
+fn is_unconditionally_denied(name: &str) -> bool {
+    const EXACT: &[&str] = &[
+        "exec_command",
+        "shell_command",
+        "write_stdin",
+        "apply_patch",
+        "write_file",
+        "edit_file",
+        "delete_file",
+        "create_file",
+        "move_file",
+        "rename_file",
+        "mkdir",
+        "remove_file",
+        "remove_directory",
+        "spawn_agent",
+        "request_permissions",
+        "execute",
+        "wait",
+    ];
+    EXACT.contains(&name)
+        || name.ends_with(".exec_command")
+        || name.ends_with(".shell_command")
+        || name.ends_with(".write_stdin")
+        || name.ends_with(".apply_patch")
+        || name.ends_with(".spawn_agent")
+        || name.ends_with(".request_permissions")
+        || name.starts_with("code_mode.")
+        || name.starts_with("terminal.")
+        || name.starts_with("pty.")
+        || name.starts_with("filesystem.write")
+        || name.starts_with("filesystem.edit")
+        || name.starts_with("filesystem.delete")
+}
+
+#[derive(Clone, Copy)]
+enum RequiredOwner {
+    Root,
+    #[cfg(test)]
+    Ids { uid: u32, gid: u32 },
+}
+
+fn load_policy(path: &Path, owner: RequiredOwner) -> anyhow::Result<ExecutionPolicy> {
+    validate_file(path, owner)?;
+    let bytes = fs::read(path).with_context(|| format!("read policy {}", path.display()))?;
+    let policy_file: PolicyFile = toml::from_str(
+        std::str::from_utf8(&bytes).context("policy is not UTF-8")?,
+    )
+    .context("parse companion execution policy")?;
+    anyhow::ensure!(
+        policy_file.version == POLICY_VERSION,
+        "unknown policy version {}",
+        policy_file.version
+    );
+    anyhow::ensure!(
+        policy_file.default_action == DefaultAction::Deny,
+        "default_action must be deny"
+    );
+    anyhow::ensure!(
+        policy_file.hosted_tools == HostedTools::Disabled,
+        "hosted_tools must be disabled"
+    );
+    anyhow::ensure!(
+        policy_file
+            .allowed_mcp_tools
+            .iter()
+            .all(|rule| !rule.server.is_empty() && !rule.raw_tool.is_empty()),
+        "MCP rules require non-empty server and raw_tool"
+    );
+    Ok(ExecutionPolicy {
+        allowed_local_tools: policy_file.allowed_local_tools.into_iter().collect(),
+        allowed_mcp_tools: policy_file.allowed_mcp_tools.into_iter().collect(),
+    })
+}
+
+#[cfg(unix)]
+fn validate_file(path: &Path, owner: RequiredOwner) -> anyhow::Result<()> {
+    use std::os::unix::fs::MetadataExt;
+    let metadata = fs::symlink_metadata(path)
+        .with_context(|| format!("stat policy {}", path.display()))?;
+    let (required_uid, required_gid) = match owner {
+        RequiredOwner::Root => (0, 0),
+        #[cfg(test)]
+        RequiredOwner::Ids { uid, gid } => (uid, gid),
+    };
+    validate_metadata(
+        metadata.uid(),
+        metadata.gid(),
+        metadata.mode() & 0o777,
+        metadata.file_type().is_file(),
+        required_uid,
+        required_gid,
+    )
+}
+
+#[cfg(unix)]
+fn validate_metadata(
+    uid: u32,
+    gid: u32,
+    mode: u32,
+    is_regular_file: bool,
+    required_uid: u32,
+    required_gid: u32,
+) -> anyhow::Result<()> {
+    anyhow::ensure!(is_regular_file, "policy must be a regular file");
+    anyhow::ensure!(
+        uid == required_uid,
+        "policy owner uid must be {required_uid}"
+    );
+    anyhow::ensure!(
+        gid == required_gid,
+        "policy owner gid must be {required_gid}"
+    );
+    anyhow::ensure!(mode == 0o644, "policy mode must be exactly 0644");
+    Ok(())
+}
+
+#[cfg(not(unix))]
+fn validate_file(_path: &Path, _owner: RequiredOwner) -> anyhow::Result<()> {
+    anyhow::bail!("execution-disabled companion policy requires Unix ownership semantics")
+}
+
+#[cfg(test)]
+#[path = "companion_execution_policy_tests.rs"]
+pub(crate) mod tests;
