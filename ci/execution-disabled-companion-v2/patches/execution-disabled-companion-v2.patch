+use super::*;
+use std::io::Write;
+
+fn policy(contents: &str) -> anyhow::Result<(tempfile::NamedTempFile, ExecutionPolicy)> {
+    use std::os::unix::fs::MetadataExt;
+    let mut file = tempfile::NamedTempFile::new()?;
+    file.write_all(contents.as_bytes())?;
+    use std::os::unix::fs::PermissionsExt;
+    file.as_file()
+        .set_permissions(fs::Permissions::from_mode(0o644))?;
+    let metadata = file.as_file().metadata()?;
+    let loaded = load_policy(
+        file.path(),
+        RequiredOwner::Ids {
+            uid: metadata.uid(),
+            gid: metadata.gid(),
+        },
+    )?;
+    Ok((file, loaded))
+}
+
+pub(crate) fn policy_for_registry() -> anyhow::Result<(tempfile::NamedTempFile, ExecutionPolicy)> {
+    policy(VALID)
+}
+
+const VALID: &str = r#"
+version = 1
+default_action = "deny"
+hosted_tools = "disabled"
+allowed_local_tools = ["view_image", "exec_command"]
+
+[[allowed_mcp_tools]]
+server = "memory_search"
+raw_tool = "memory_search"
+
+[[allowed_mcp_tools]]
+server = "future"
+raw_tool = "weather"
+connector = "connector-weather"
+"#;
+
+#[test]
+fn dangerous_local_tool_is_denied_even_if_listed() -> anyhow::Result<()> {
+    let (_file, policy) = policy(VALID)?;
+    assert_eq!(
+        policy.authorize(&ToolName::plain("exec_command"), &RuntimeOrigin::Local),
+        Err(PolicyDenial {
+            canonical_tool: "exec_command".to_string(),
+            reason: PolicyDenialReason::HardDeny,
+        })
+    );
+    assert_eq!(POLICY_DENIAL_CODE, "execution_disabled_by_runtime_policy");
+    Ok(())
+}
+
+#[test]
+fn unknown_local_runtime_is_denied_by_default() -> anyhow::Result<()> {
+    let (_file, policy) = policy(VALID)?;
+    assert!(
+        policy
+            .authorize(
+                &ToolName::plain("brand_new_runtime"),
+                &RuntimeOrigin::Local
+            )
+            .is_err()
+    );
+    Ok(())
+}
+
+#[test]
+fn mcp_identity_is_exact_and_policy_only_addition_can_allow_new_tool() -> anyhow::Result<()> {
+    let (_file, policy) = policy(VALID)?;
+    let memory = RuntimeOrigin::Mcp {
+        server: "memory_search".into(),
+        raw_tool: "memory_search".into(),
+        connector: None,
+    };
+    assert!(
+        policy
+            .authorize(
+                &ToolName::namespaced("mcp__memory_search", "memory_search"),
+                &memory
+            )
+            .is_ok()
+    );
+    let future = RuntimeOrigin::Mcp {
+        server: "future".into(),
+        raw_tool: "weather".into(),
+        connector: Some("connector-weather".into()),
+    };
+    assert!(
+        policy
+            .authorize(&ToolName::namespaced("future", "weather"), &future)
+            .is_ok()
+    );
+    let wrong_connector = RuntimeOrigin::Mcp {
+        connector: None,
+        ..future
+    };
+    assert!(
+        policy
+            .authorize(
+                &ToolName::namespaced("future", "weather"),
+                &wrong_connector
+            )
+            .is_err()
+    );
+    Ok(())
+}
+
+#[test]
+fn rejects_unknown_fields_versions_and_writable_mode() -> anyhow::Result<()> {
+    assert!(policy(&VALID.replace("version = 1", "version = 2")).is_err());
+    assert!(policy("this is not toml = [").is_err());
+    assert!(policy(&format!("{VALID}\nunknown = true\n")).is_err());
+    let (file, _) = policy(VALID)?;
+    let mut perms = file.as_file().metadata()?.permissions();
+    use std::os::unix::fs::PermissionsExt;
+    perms.set_mode(0o666);
+    file.as_file().set_permissions(perms)?;
+    use std::os::unix::fs::MetadataExt;
+    let metadata = file.as_file().metadata()?;
+    assert!(
+        load_policy(
+            file.path(),
+            RequiredOwner::Ids {
+                uid: metadata.uid(),
+                gid: metadata.gid(),
+            }
+        )
+        .is_err()
+    );
+    Ok(())
+}
+
+#[test]
+fn rejects_wrong_owner_non_regular_file_and_noncanonical_mode() {
+    assert!(validate_metadata(1000, 0, 0o644, true, 0, 0).is_err());
+    assert!(validate_metadata(0, 1000, 0o644, true, 0, 0).is_err());
+    assert!(validate_metadata(0, 0, 0o644, false, 0, 0).is_err());
+    assert!(validate_metadata(0, 0, 0o640, true, 0, 0).is_err());
+    assert!(validate_metadata(0, 0, 0o664, true, 0, 0).is_err());
+    assert!(validate_metadata(0, 0, 0o644, true, 0, 0).is_ok());
+}
+
+#[test]
+fn missing_policy_fails_closed() {
+    assert!(
+        load_policy(
+            Path::new("/definitely/missing/companion-policy.toml"),
+            RequiredOwner::Root
+        )
+        .is_err()
+    );
+}
