+#[cfg(feature = "frontend_b_companion")]
+#[tokio::test]
+async fn frontend_b_companion_final_registry_is_exactly_memory_search() {
+    let plan = probe_with(
+        |turn| set_feature(turn, Feature::CodeMode, true),
+        ToolPlanInputs {
+            tool_runtimes: vec![
+                mcp_runtime(
+                    "memory_search",
+                    "mcp__memory_search",
+                    "memory_search",
+                    ToolExposure::Deferred,
+                ),
+                mcp_runtime(
+                    "filesystem",
+                    "mcp__filesystem",
+                    "read_file",
+                    ToolExposure::Direct,
+                ),
+            ],
+            dynamic_tools: vec![dynamic_tool(None, "unlisted_dynamic", false)],
+            ..ToolPlanInputs::default()
+        },
+    )
+    .await;
+
+    let memory_search_name =
+        ToolName::namespaced("mcp__memory_search", "memory_search").to_string();
+    assert_eq!(plan.registered_names, [memory_search_name.clone()]);
+    assert_eq!(plan.exposure(&memory_search_name), ToolExposure::Direct);
+    assert_eq!(
+        plan.namespace_function_names("mcp__memory_search"),
+        ["memory_search"]
+    );
+    assert_eq!(plan.visible_specs.len(), 1);
+    assert!(!plan.visible_names.iter().any(|name| name == "tool_search"));
+
+    let ToolSpec::Namespace(namespace) = &plan.visible_specs[0] else {
+        panic!("expected the memory_search namespace spec");
+    };
+    assert_eq!(namespace.name, "mcp__memory_search");
+    assert_eq!(namespace.tools.len(), 1);
+    let codex_tools::ResponsesApiNamespaceTool::Function(memory_search) = &namespace.tools[0];
+    assert_eq!(memory_search.name, "memory_search");
+    assert_eq!(memory_search.description, "memory_search test tool");
+    assert_eq!(
+        serde_json::to_value(&memory_search.parameters).expect("schema should serialize"),
+        json!({
+            "type": "object",
+            "properties": {},
+            "additionalProperties": false,
+        })
+    );
+    assert_eq!(memory_search.defer_loading, None);
+}
